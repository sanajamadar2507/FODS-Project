# ReliefLink Environment Variables

# Admin Signup Invite Code (required for creating an admin account)
ADMIN_CODE=RELIEF2026

# JWT Authentication Secret (32+ characters)
JWT_SECRET=relieflink-secret-key-disaster-relief-secure-2026

# Database Connection (PostgreSQL / Supabase Postgres)
# Leave empty or omit to use the built-in auto-initialized relational store for instant local testing,
# or set to your Supabase/PostgreSQL connection string for production:
# DATABASE_URL=postgresql://postgres.xxx:password@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL=

# App Settings
NEXT_PUBLIC_APP_NAME=ReliefLink
